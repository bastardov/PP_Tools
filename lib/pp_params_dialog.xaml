<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры"
        Width="440"
        MinWidth="400"
        MinHeight="280"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- описание -->
      <RowDefinition Height="Auto"/>   <!-- схема -->
      <RowDefinition Height="Auto"/>   <!-- поля -->
      <RowDefinition Height="*"/>      <!-- растяжка -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="{Binding Title}"/>

    <TextBlock Grid.Row="1" Style="{StaticResource Subtitle}" Margin="0,4,0,0"
               Text="{Binding Subtitle}"
               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolVis}}"/>

    <!-- Поясняющая схема: разметку передаёт вызывающий инструмент -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0,12,0,12"
            Visibility="{Binding HasDiagram, Converter={StaticResource BoolVis}}">
      <ContentControl x:Name="DiagramHost" HorizontalAlignment="Center"/>
    </Border>

    <!-- Поля создаются кодом по описанию из конфигурации -->
    <StackPanel Grid.Row="3" x:Name="PanelFields" Margin="0,14,0,0"/>

    <Border Grid.Row="5" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="6" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="{Binding RunLabel}" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
