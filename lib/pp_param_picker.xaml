<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор параметра"
        Width="640"
        Height="620"
        MinWidth="520"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="TxtPickerTitle" Style="{StaticResource H1}"/>
      <TextBlock x:Name="TxtPickerSubtitle" Style="{StaticResource Subtitle}"
                 Margin="0,2,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ПОИСК"/>
      <TextBox x:Name="TxtSearch" Style="{StaticResource TextBox.Field}"
               ToolTip="Введите часть имени параметра"/>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Border Style="{StaticResource Card}">
        <ListBox x:Name="LstParameters"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="4"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource PP.ListBoxItem}"/>
      </Border>
      <TextBlock x:Name="TxtEmpty" Style="{StaticResource EmptyState}"
                 Text="Параметры не найдены. Измените поиск или впишите имя вручную."
                 TextWrapping="Wrap" Margin="32"/>
    </Grid>

    <TextBlock x:Name="TxtPickerStatus" Grid.Row="3" Style="{StaticResource Caption}"
               Margin="0,6,0,0"/>

    <Border Grid.Row="4" Style="{StaticResource Rule}" Margin="0,12,0,0"/>

    <Grid Grid.Row="5" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Style="{StaticResource Status}"
                 Text="Двойной щелчок также выбирает параметр."
                 VerticalAlignment="Center" Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnPickerCancel" Content="Отмена"
                Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnPickerSelect" Content="Выбрать"
                Style="{StaticResource Button.Primary}" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
