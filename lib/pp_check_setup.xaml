<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка"
        Width="940"
        Height="660"
        MinWidth="820"
        MinHeight="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="*"/>      <!-- две колонки -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="{Binding Title}"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" Text="{Binding Subtitle}"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Левая колонка: проверки и область ===== -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="КАКИЕ ПРОВЕРКИ ЗАПУСТИТЬ"/>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <ListBox x:Name="LstChecks"
                     BorderThickness="0" Background="Transparent" Padding="4"
                     ItemContainerStyle="{StaticResource PP.ListBoxItem}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock Style="{StaticResource EmptyState}"
                       Visibility="{Binding HasNoChecks, Converter={StaticResource BoolVis}}"
                       Text="{Binding EmptyText}"/>
          </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BtnCheckAll" Content="Отметить все" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Margin="0,0,6,0"/>
          <Button x:Name="BtnUncheckAll" Content="Снять все" Style="{StaticResource Button.Flat}"
                  MinWidth="0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0"
                    Visibility="{Binding HasScope, Converter={StaticResource BoolVis}}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="ОБЛАСТЬ ПРОВЕРКИ"/>
          <WrapPanel>
            <RadioButton x:Name="ChipModel" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Scope" Content="Вся модель"
                         ToolTip="Дольше: геометрия каждого элемента"/>
            <RadioButton x:Name="ChipSelection" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Scope" Content="{Binding SelectionLabel}"
                         IsEnabled="{Binding HasSelection}"
                         ToolTip="Проверяются только выделенные в модели элементы"/>
          </WrapPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding ScopeHint}"/>
        </StackPanel>
      </Grid>

      <!-- ===== Правая колонка: настройки выбранной проверки ===== -->
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{Binding RuleTitle}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,14,16">
            <StackPanel>
              <TextBlock x:Name="TxtRuleDescription" Style="{StaticResource Body}"
                         Foreground="{StaticResource Muted}"
                         Text="{Binding RuleDescription}"/>

              <Border Style="{StaticResource Rule}" Margin="0,16,0,16"
                      Visibility="{Binding HasOptions, Converter={StaticResource BoolVis}}"/>

              <!-- Поля опций строятся кодом: их состав зависит от проверки -->
              <StackPanel x:Name="PanelOptions"/>

              <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                         Visibility="{Binding HasNoOptions, Converter={StaticResource BoolVis}}"
                         Text="У этой проверки нет настраиваемых параметров."/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="2" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="{Binding RunLabel}" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
