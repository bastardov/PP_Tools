# --- кэш Python / IronPython ---
__pycache__/
*.pyc
*.pyo

# --- данные пользователя, у каждого свои ---
# статистика запусков инструментов (append-only, конфликтует при слиянии)
telemetry/
# рабочие логи инструментов и startup.py
_logs/
# папка обмена с ИИ-агентом: выгрузка модели и команды агента —
# всё генерируется заново, в репозитории нужен только формат обмена
AI_обмен/*
!AI_обмен/README.md

# --- страховка: рабочие данные любых инструментов ---
# (даже если появятся вне telemetry/ и _logs/)
*.jsonl
*.log

# --- служебное Windows ---
Thumbs.db
desktop.ini
*.tmp
*.bak
~$*

# --- локальные бэкапы, если папка появится снова ---
BACKUPS/

# временный остаток от первого создания репозитория (удаляется git_очистка.bat)
_git_old_удалить/

# --- личные настройки плагина (создаются сами из значений по умолчанию) ---
lib/pp_settings.json
lib/pp_settings.json.bak
lib/pp_settings*.invalid*

# --- выгрузка и бэкап на свой сервер: личное, в репозитории не нужно ---
# пути к серверу (у каждого свои) и сами скрипты
сервер_путь.txt
выгрузить_на_сервер.bat
резервные_копии_путь.txt
резервная_копия.bat
