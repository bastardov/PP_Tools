<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика использования"
        Width="980"
        Height="640"
        MinWidth="820"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок и итоги -->
      <RowDefinition Height="Auto"/>   <!-- группировка, модель, поиск -->
      <RowDefinition Height="Auto"/>   <!-- пояснение к режиму -->
      <RowDefinition Height="Auto"/>   <!-- шапка таблицы -->
      <RowDefinition Height="*"/>      <!-- строки -->
      <RowDefinition Height="Auto"/>   <!-- путь к логам -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Статистика использования"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" Text="{Binding Overall}"/>
    </StackPanel>

    <!-- ===== Группировка, модель и поиск ===== -->
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="ГРУППИРОВКА"/>
        <WrapPanel>
          <RadioButton x:Name="ChipTool" Style="{StaticResource RadioButton.Chip}"
                       GroupName="GroupBy" Content="По инструментам" MinWidth="0"/>
          <RadioButton x:Name="ChipUser" Style="{StaticResource RadioButton.Chip}"
                       GroupName="GroupBy" Content="По пользователям" MinWidth="0"/>
          <RadioButton x:Name="ChipBoth" Style="{StaticResource RadioButton.Chip}"
                       GroupName="GroupBy" Content="Инструменты и пользователи" MinWidth="0"/>
          <RadioButton x:Name="ChipPhase" Style="{StaticResource RadioButton.Chip}"
                       GroupName="GroupBy" Content="По фазам модели" MinWidth="0"
                       ToolTip="Где инструмент живёт на шкале работы над моделью: ближе к началу или к оформлению"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="МОДЕЛЬ"/>
        <ComboBox x:Name="CmbModel" Style="{StaticResource PP.ComboBox}" Width="240"
                  ToolTip="Считать только по выбранной модели. В скобках — сколько в ней запусков"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Margin="14,0,0,0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="ПОИСК"/>
        <TextBox x:Name="TxtSearch" Style="{StaticResource TextBox.Field}" Width="200"
                 ToolTip="Показывать только строки, где встречается этот текст"/>
      </StackPanel>
    </Grid>

    <!-- Пояснение к режиму: видно только там, где оно есть (сейчас — фазы) -->
    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0"
               TextWrapping="Wrap"
               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"
               Text="{Binding Note}"/>

    <!-- Шапка таблицы: заголовки для сортировки строит код.
         Отступы повторяют путь до содержимого строки, иначе колонки разъедутся:
         1 рамка карточки + 4 padding списка + 8 padding строки = 13 слева,
         справа те же 13 плюс 12 на полосу прокрутки. -->
    <Border Grid.Row="3" Margin="0,14,0,0" Padding="13,0,25,6">
      <Grid x:Name="PanelHeader"/>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}">
      <Grid>
        <!-- Полоса прокрутки зарезервирована всегда: иначе при её появлении
             строки сузятся и разойдутся с шапкой. -->
        <ListBox x:Name="LstRows"
                 BorderThickness="0" Background="Transparent" Padding="4"
                 ItemContainerStyle="{StaticResource PP.ListBoxItem}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"/>
        <TextBlock Style="{StaticResource EmptyState}"
                   Visibility="{Binding HasNoRows, Converter={StaticResource BoolVis}}"
                   Text="{Binding EmptyText}"/>
      </Grid>
    </Border>

    <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Margin="0,8,0,0"
               Text="{Binding FolderText}"/>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="6" Style="{StaticResource Rule}" Margin="0,14,0,0"/>

    <Grid Grid.Row="7" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnFolder" Content="Открыть папку логов" Style="{StaticResource Button.Flat}"
                MinWidth="0" Margin="0,0,8,0"
                ToolTip="Показать папку с файлами учёта в проводнике"/>
        <Button x:Name="BtnExport" Content="Экспортировать в CSV" Style="{StaticResource Button.Flat}"
                MinWidth="0" Margin="0,0,8,0"
                ToolTip="Сохранить видимые строки в файл .csv"/>
        <Button x:Name="BtnClose" Content="Закрыть" Style="{StaticResource Button.Primary}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
