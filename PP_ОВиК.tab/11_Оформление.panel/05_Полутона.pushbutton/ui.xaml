<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Полутона"
        Width="920"
        Height="680"
        MinWidth="820"
        MinHeight="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="*"/>      <!-- две колонки -->
      <RowDefinition Height="Auto"/>   <!-- нижняя подсказка -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Полутона"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                 Text="Полутон включается выбранным категориям сразу во всех отмеченных шаблонах видов."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Слева: шаблоны видов ===== -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="ШАБЛОНЫ ВИДОВ"/>
        <!-- Список построен кодом: общий контрол из lib/pp_check_list -->
        <ContentControl x:Name="HostTemplates" Grid.Row="1"/>
      </Grid>

      <!-- ===== Справа: категории ===== -->
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                   Text="КАТЕГОРИИ — ПОЛУТОН ВКЛЮЧИТЬ"/>
        <ContentControl x:Name="HostCategories" Grid.Row="1"/>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,14,0,0"
               Text="Снятая галочка категории не выключает полутон, а просто не трогает его. Выключать нужно вручную в настройках видимости."/>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="3" Style="{StaticResource Rule}" Margin="0,14,0,0"/>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Применить" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
