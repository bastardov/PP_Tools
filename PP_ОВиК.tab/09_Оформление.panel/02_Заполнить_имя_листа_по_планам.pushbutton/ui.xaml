<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заполнить имя листа по планам"
        Width="1000"
        Height="660"
        MinWidth="900"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- кнопки над таблицей -->
      <RowDefinition Height="Auto"/>   <!-- шапка таблицы -->
      <RowDefinition Height="*"/>      <!-- строки -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Имя листа по планам"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                 Text="Проверьте предлагаемые имена. Колонку «Станет» можно править прямо в строке, а снятая галочка пропускает лист."/>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,14,0,0">
      <Button x:Name="BtnAll" Content="Отметить все" Style="{StaticResource Button.Flat}"
              MinWidth="0" Padding="12,5,12,5" Margin="0,0,6,6"/>
      <Button x:Name="BtnNone" Content="Снять все" Style="{StaticResource Button.Flat}"
              MinWidth="0" Padding="12,5,12,5" Margin="0,0,6,6"/>
      <Button x:Name="BtnReset" Content="Вернуть предложенные" Style="{StaticResource Button.Flat}"
              MinWidth="0" Padding="12,5,12,5" Margin="0,0,0,6"
              ToolTip="Отменить ручную правку имён и вернуть то, что предложил инструмент"/>
    </WrapPanel>

    <!-- Отступы шапки повторяют путь до содержимого строки, иначе колонки
         разъедутся: 1 рамка карточки + 4 padding списка + 8 padding строки
         = 13 слева, справа те же 13 плюс 12 на полосу прокрутки. -->
    <Grid Grid.Row="2" Margin="13,6,25,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="150"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="ЛИСТ"/>
      <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="БЫЛО — ИМЯ ВИДА"/>
      <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="СТАНЕТ — ИМЯ ЛИСТА"/>
      <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="ПРИМЕЧАНИЕ"/>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource Card}">
      <Grid>
        <!-- Полоса прокрутки зарезервирована всегда: иначе при её появлении
             строки сузятся и разойдутся с шапкой. -->
        <ListBox x:Name="LstRows"
                 BorderThickness="0" Background="Transparent" Padding="4"
                 ItemContainerStyle="{StaticResource PP.ListBoxItem}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"/>
        <TextBlock Style="{StaticResource EmptyState}"
                   Visibility="{Binding HasNoRows, Converter={StaticResource BoolVis}}"
                   Text="Среди выбранных листов нет ни одного, для которого удалось предложить имя."/>
      </Grid>
    </Border>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="4" Style="{StaticResource Rule}" Margin="0,14,0,0"/>

    <Grid Grid.Row="5" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Записать имена" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
