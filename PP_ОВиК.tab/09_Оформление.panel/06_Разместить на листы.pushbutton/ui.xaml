<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разместить на листы"
        Width="1000"
        Height="820"
        MinWidth="880"
        MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>                   <!-- заголовок -->
      <RowDefinition Height="*" MinHeight="260"/>      <!-- две колонки -->
      <RowDefinition Height="Auto"/>                   <!-- разделитель -->
      <RowDefinition Height="Auto"/>                   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Разместить на листы"/>
      <TextBlock x:Name="TxtSubtitle" Style="{StaticResource Subtitle}"
                 Margin="0,2,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Левая колонка: что размещаем ===== -->
      <Grid Grid.Column="0" Margin="0,0,14,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="ЧТО РАЗМЕЩАЕМ"/>
          <WrapPanel Margin="0,6,0,0">
            <RadioButton x:Name="ChipPlans" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Mode" Content="Планы — каждый на свой лист" MinWidth="0"
                         Margin="0,0,6,0"
                         ToolTip="Планы этажей, потолков, зон: один план — один лист, по центру"/>
            <RadioButton x:Name="ChipViews" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Mode" Content="Виды — вместе на один лист" MinWidth="0"
                         ToolTip="3D-виды, разрезы, фасады, чертёжные виды: все отмеченные рядами на одном листе"/>
          </WrapPanel>
        </StackPanel>

        <TextBlock x:Name="TxtListLabel" Grid.Row="1" Margin="0,14,0,0"
                   Style="{StaticResource FieldLabel}" Text="КАКИЕ ПЛАНЫ РАЗМЕСТИТЬ"/>

        <StackPanel x:Name="PanelTemplate" Grid.Row="2" Margin="0,6,0,0">
          <ComboBox x:Name="CmbTemplate" Style="{StaticResource PP.ComboBox}"
                    ToolTip="Показывать в списке только виды с выбранным шаблоном вида"/>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Фильтр по шаблону вида. Отметки не сбрасываются: можно набрать виды из нескольких шаблонов."/>
        </StackPanel>

        <ContentControl x:Name="ListHost" Grid.Row="3" Margin="0,8,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
      </Grid>

      <!-- ===== Правая колонка: как оформить; итог закреплён внизу ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel>

          <TextBlock Style="{StaticResource FieldLabel}" Text="ЛИСТ-ОБРАЗЕЦ"/>
          <ComboBox x:Name="CmbSample" Style="{StaticResource PP.ComboBox}"
                    Margin="0,6,0,0"
                    ToolTip="С этого листа копируется основная надпись со всеми её настройками"/>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="С него копируется основная надпись со всеми настройками. Виды, текст и легенды образца не копируются."/>

          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0"
                     Text="РАЗДЕЛ ПРОЕКТА"/>
          <TextBox x:Name="TxtSection" Style="{StaticResource TextBox.Field}"
                   Margin="0,6,0,0" Tag="Раздел новых листов, например ОВ"/>
          <WrapPanel x:Name="PanelSections" Margin="0,6,0,0"/>
          <TextBlock x:Name="TxtSectionHint" Style="{StaticResource Caption}" Margin="0,2,0,0"
                     TextWrapping="Wrap"
                     Text="Разделы, которые уже есть в проекте — щёлкните по чипсу, и он подставится в поле выше."/>

          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0"
                     Text="НУМЕРАЦИЯ"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBox x:Name="TxtStart" Style="{StaticResource TextBox.Field}"
                       Tag="Начать с номера, например 12"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                         Text="Первый номер. Занятые пропускаются."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBox x:Name="TxtSuffix" Style="{StaticResource TextBox.Field}"
                       Tag="Суффикс номера, например ОВ"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                         Text="Приписывается к номеру: 12ОВ, 13ОВ…"/>
            </StackPanel>
          </Grid>

          <!-- Только режим «Виды»: начало имени листа -->
          <StackPanel x:Name="PanelPrefix" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="НАЧАЛО ИМЕНИ ЛИСТА"/>
            <ComboBox x:Name="CmbPrefix" Style="{StaticResource PP.ComboBox}"
                      Margin="0,6,0,0"
                      ToolTip="Начало имени из панели «Настройки»; системы дописываются по именам видов"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="К началу дописываются системы из имён видов, которые легли на лист: «Схема систем П1-П3, В1». Список — в панели «Настройки»."/>
          </StackPanel>

          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0"
                     Text="ОРИЕНТАЦИЯ ЛИСТА"/>
          <WrapPanel Margin="0,6,0,0">
            <RadioButton x:Name="ChipLandscape" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Orientation" Content="Альбомная" MinWidth="0" Margin="0,0,6,6"
                         ToolTip="Только альбомные листы — галочка «Книжная ориентация» в рамке не ставится"/>
            <RadioButton x:Name="ChipPortrait" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Orientation" Content="Книжная" MinWidth="0" Margin="0,0,6,6"
                         ToolTip="Только книжные листы"/>
            <RadioButton x:Name="ChipAnyOrientation" Style="{StaticResource RadioButton.Chip}"
                         GroupName="Orientation" Content="Подобрать" MinWidth="0" Margin="0,0,6,6"
                         ToolTip="Для каждого формата сначала альбомная, потом книжная — берётся меньший подходящий лист"/>
          </WrapPanel>
          <TextBlock x:Name="TxtOrientationHint" Style="{StaticResource Caption}" Margin="0,0,0,0"
                     TextWrapping="Wrap"/>

          <!-- ===== Заголовки видов ===== -->
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0"
                     Text="ЗАГОЛОВКИ ВИДОВ"/>
          <ComboBox x:Name="CmbTitleType" Style="{StaticResource PP.ComboBox}"
                    Margin="0,6,0,0"
                    ToolTip="Тип видового экрана: семейство заголовка, линия, показывать ли заголовок"/>
          <TextBlock x:Name="TxtTitleTypeHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     Text="Тип видового экрана — какое семейство заголовка и есть ли линия."/>

          <StackPanel x:Name="PanelTitleText" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="Текст заголовка"/>
            <WrapPanel Margin="0,3,0,0">
              <RadioButton x:Name="ChipTitleSystems" Style="{StaticResource RadioButton.Chip}"
                           GroupName="TitleText" Content="Системы из имени вида" MinWidth="0" Margin="0,0,6,6"
                           ToolTip="В «Заголовок на листе» пишется «Система П1» или «Системы П1-П3» по имени вида"/>
              <RadioButton x:Name="ChipTitleKeep" Style="{StaticResource RadioButton.Chip}"
                           GroupName="TitleText" Content="Не менять" MinWidth="0" Margin="0,0,6,6"
                           ToolTip="«Заголовок на листе» остаётся как есть; пустой — Revit покажет имя вида"/>
            </WrapPanel>
          </StackPanel>

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Caption}" Text="Где относительно вида"/>
              <WrapPanel Margin="0,3,0,0">
                <RadioButton x:Name="ChipTitleAbove" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleV" Content="Над" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Заголовок над рамкой вида"/>
                <RadioButton x:Name="ChipTitleBelow" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleV" Content="Под" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Заголовок под рамкой вида"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Caption}" Text="Выравнивание"/>
              <WrapPanel Margin="0,3,0,0">
                <RadioButton x:Name="ChipTitleLeft" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleH" Content="Слева" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Начало заголовка по левому краю вида"/>
                <RadioButton x:Name="ChipTitleCenter" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleH" Content="По центру" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Заголовок по центру вида"/>
                <RadioButton x:Name="ChipTitleRight" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleH" Content="Справа" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Конец заголовка по правому краю вида"/>
              </WrapPanel>
            </StackPanel>
          </Grid>

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Caption}" Text="Длина линии"/>
              <WrapPanel Margin="0,3,0,0">
                <RadioButton x:Name="ChipLineText" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleLine" Content="По тексту" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Линия под заголовком по длине текста"/>
                <RadioButton x:Name="ChipLineView" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleLine" Content="По ширине вида" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Линия на всю ширину рамки вида"/>
                <RadioButton x:Name="ChipLineKeep" Style="{StaticResource RadioButton.Chip}"
                             GroupName="TitleLine" Content="Не менять" MinWidth="0" Margin="0,0,6,6"
                             ToolTip="Длина линии как у нового видового экрана"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Caption}" Text="Отступ от вида, мм"/>
              <TextBox x:Name="TxtTitleGap" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"
                       Tag="например 3"/>
            </StackPanel>
          </Grid>

          <CheckBox x:Name="ChkTitleRows" Style="{StaticResource PP.CheckBox}" Margin="0,4,0,0"
                    Content="Заголовки видов в ряду — на одной высоте"
                    ToolTip="Виды в ряду выравниваются по краю со стороны заголовка, и заголовки встают в линию"/>

          <ToggleButton x:Name="TglMargins" Style="{StaticResource ToggleButton.Expander}"
                        Margin="0,10,0,0" Content="Поля рамки и подбор формата"/>
          <StackPanel x:Name="PanelMargins" Margin="0,4,0,0"
                      Visibility="{Binding IsChecked, ElementName=TglMargins, Converter={StaticResource BoolVis}}">
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Рабочая область листа = рамка минус поля. Формат перебирается от А3 к А0, затем удлинённые через «Кратность» (кратность 2 пропускается)."/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Caption}" Text="Слева, мм"/>
                <TextBox x:Name="TxtLeft" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="Справа, мм"/>
                <TextBox x:Name="TxtRight" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource Caption}" Text="Сверху, мм"/>
                <TextBox x:Name="TxtTop" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="6">
                <TextBlock Style="{StaticResource Caption}" Text="Снизу (штамп), мм"/>
                <TextBox x:Name="TxtBottom" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>

            <StackPanel x:Name="PanelGap" Margin="0,8,0,0">
              <TextBlock Style="{StaticResource Caption}" Text="Зазор между видами, мм"/>
              <TextBox x:Name="TxtGap" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"
                       Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

          </StackPanel>


        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource Card.Result}" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="TxtResultLabel" Style="{StaticResource FieldLabel}"
                       Text="БУДЕТ СОЗДАНО"/>
            <TextBlock x:Name="TxtResult" Style="{StaticResource Body.Result}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtResultDetail" Style="{StaticResource Caption}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Rule}" Margin="0,12,0,0"/>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0" Style="{StaticResource Status}"
                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена"
                Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Создать листы"
                Style="{StaticResource Button.Primary}" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
