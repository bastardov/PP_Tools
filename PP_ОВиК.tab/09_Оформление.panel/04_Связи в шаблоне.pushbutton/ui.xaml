<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Связи в шаблоне"
        Width="960"
        Height="700"
        MinWidth="860"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="*"/>      <!-- две колонки -->
      <RowDefinition Height="Auto"/>   <!-- нижняя подсказка -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Связи в шаблоне"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                 Text="Видимость связанных файлов RVT задаётся сразу для набора шаблонов и видов."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Левая колонка: к чему применяем ===== -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="К ЧЕМУ ПРИМЕНИТЬ"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
          <RadioButton x:Name="ChipTemplates" Style="{StaticResource RadioButton.Chip}"
                       GroupName="Target" Content="Шаблоны видов" MinWidth="0"/>
          <RadioButton x:Name="ChipViews" Style="{StaticResource RadioButton.Chip}"
                       GroupName="Target" Content="Виды" MinWidth="0"/>
          <RadioButton x:Name="ChipPlanTemplates" Style="{StaticResource RadioButton.Chip}"
                       GroupName="Target" Content="Шаблоны видов ПЭ" MinWidth="0"
                       ToolTip="Те же шаблоны видов, но в списке остаются только плановые (планы этажей, потолков, несущих конструкций, зон)"/>
        </WrapPanel>

        <Grid Grid.Row="2">
          <!-- Оба списка построены кодом, показывается один -->
          <ContentControl x:Name="HostTemplates"
                          Visibility="{Binding IsTemplates, Converter={StaticResource BoolVis}}"/>
          <ContentControl x:Name="HostViews"
                          Visibility="{Binding IsViews, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Grid>

      <!-- ===== Правая колонка: состояние связей ===== -->
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="СВЯЗАННЫЕ ФАЙЛЫ RVT"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,-2,0,6"
                   Text="Галочка стоит — связь видна. Галочка снята — связь выключается."/>

        <Border Grid.Row="2" Style="{StaticResource Card}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,10,6">
            <StackPanel x:Name="PanelLinks"/>
          </ScrollViewer>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
          <Button x:Name="BtnLinksAll" Content="Все видны" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="12,5,12,5" Margin="0,0,6,6"/>
          <Button x:Name="BtnLinksNone" Content="Все скрыты" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="12,5,12,5" Margin="0,0,6,6"/>
          <Button x:Name="BtnLinksCurrent" Content="Как в текущем виде" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="12,5,12,5" Margin="0,0,0,6"
                  ToolTip="Снять состояние связей с активного вида"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="{Binding LinksCounter}"/>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,14,0,0"
               Text="Связь выключается целиком — и сам файл связи, и все его экземпляры. Остальные настройки связей не меняются."/>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="3" Style="{StaticResource Rule}" Margin="0,14,0,0"/>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Применить" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
