<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аудит модели"
        Width="1020"
        Height="660"
        MinWidth="900"
        MinHeight="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- поиск -->
      <RowDefinition Height="*"/>      <!-- две колонки -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="{Binding Headline}"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" Text="{Binding Summary}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ПОИСК ПО ТЕКСТУ ПРЕДУПРЕЖДЕНИЯ"/>
      <TextBox x:Name="TxtSearch" Style="{StaticResource TextBox.Field}" Width="360"
               ToolTip="Показывать только предупреждения, где встречается этот текст"/>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="560"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Левая колонка: группы предупреждений ===== -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Отступы шапки повторяют путь до содержимого строки, иначе колонки
             разъедутся: 1 рамка карточки + 4 padding списка + 8 padding строки
             = 13 слева, справа те же 13 плюс 12 на полосу прокрутки. -->
        <Grid Grid.Row="0" Margin="13,0,25,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="130"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="ПРЕДУПРЕЖДЕНИЕ"/>
          <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="КОЛ-ВО"/>
          <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="ВПЕРВЫЕ ЗАМЕЧЕНО"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <!-- Полоса прокрутки зарезервирована всегда: иначе при её появлении
                 строки сузятся и разойдутся с шапкой. -->
            <ListBox x:Name="LstGroups"
                     BorderThickness="0" Background="Transparent" Padding="4"
                     ItemContainerStyle="{StaticResource PP.ListBoxItem}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"/>
            <TextBlock Style="{StaticResource EmptyState}"
                       Visibility="{Binding HasNoGroups, Converter={StaticResource BoolVis}}"
                       Text="{Binding EmptyGroupsText}"/>
          </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
          <Button x:Name="BtnSelectGroup" Content="Выделить все по группе" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="14,8,14,8" Margin="0,0,6,6"
                  ToolTip="Выделяет в модели все элементы выбранного предупреждения"/>
          <Button x:Name="BtnExport" Content="Экспортировать в CSV" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="14,8,14,8" Margin="0,0,6,6"
                  ToolTip="Сохранить видимые группы предупреждений в файл .csv"/>
          <Button x:Name="BtnRefresh" Content="Обновить" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="14,8,14,8" Margin="0,0,0,6"
                  ToolTip="Перечитать предупреждения модели заново"/>
        </WrapPanel>
      </Grid>

      <!-- ===== Правая колонка: элементы выбранной группы ===== -->
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                   Text="ЭЛЕМЕНТЫ ГРУППЫ — ДВОЙНОЙ КЛИК ВЫДЕЛЯЕТ В МОДЕЛИ"/>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <ListBox x:Name="LstIds" ItemsSource="{Binding Ids}"
                     BorderThickness="0" Background="Transparent" Padding="4"
                     ItemContainerStyle="{StaticResource PP.ListBoxItem}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <TextBlock Style="{StaticResource EmptyState}"
                       Visibility="{Binding HasNoIds, Converter={StaticResource BoolVis}}"
                       Text="Выберите предупреждение слева, чтобы увидеть его элементы."/>
          </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
          <Button x:Name="BtnSelectOne" Content="Выделить элемент" Style="{StaticResource Button.Flat}"
                  MinWidth="0" Padding="14,8,14,8" Margin="0,0,0,6"
                  ToolTip="То же, что двойной клик по строке"/>
        </WrapPanel>
      </Grid>
    </Grid>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="3" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <Button x:Name="BtnClose" Grid.Column="1" Content="Закрыть"
              Style="{StaticResource Button.Primary}"/>
    </Grid>

  </Grid>
</Window>
