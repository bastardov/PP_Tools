<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Опуск / Подъем трассы"
        Width="470"
        MinWidth="430"
        MinHeight="430"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- описание -->
      <RowDefinition Height="Auto"/>   <!-- схема -->
      <RowDefinition Height="Auto"/>   <!-- режим -->
      <RowDefinition Height="Auto"/>   <!-- угол -->
      <RowDefinition Height="Auto"/>   <!-- величина -->
      <RowDefinition Height="Auto"/>   <!-- отметка от уровня -->
      <RowDefinition Height="Auto"/>   <!-- галочки -->
      <RowDefinition Height="*"/>      <!-- растяжка -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <!-- ===== Заголовок ===== -->
    <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="Опуск / Подъем трассы"/>

    <TextBlock Grid.Row="1" Style="{StaticResource Subtitle}" Margin="0,4,0,0"
               Text="Участок разрывается в указанной точке, часть трассы переносится по высоте и соединяется наклонной вставкой."/>

    <!-- ===== Схема: наглядный профиль результата ===== -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0,12,0,12">
      <Grid Height="62">

        <!-- Опуск -->
        <Canvas x:Name="DiagramDown" Width="300" Height="62"
                Visibility="{Binding IsDown, Converter={StaticResource BoolVis}}">
          <Path Data="M 10,16 L 120,16" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 120,16 L 175,46" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 175,46 L 290,46" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="115" Canvas.Top="11" Width="10" Height="10"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Hot}" StrokeThickness="1.8"/>
          <TextBlock Canvas.Left="132" Canvas.Top="0" Style="{StaticResource Caption}" Text="точка разрыва"/>
        </Canvas>

        <!-- Подъем -->
        <Canvas x:Name="DiagramUp" Width="300" Height="62"
                Visibility="{Binding IsUp, Converter={StaticResource BoolVis}}">
          <Path Data="M 10,46 L 120,46" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 120,46 L 175,16" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 175,16 L 290,16" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="115" Canvas.Top="41" Width="10" Height="10"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Hot}" StrokeThickness="1.8"/>
          <TextBlock Canvas.Left="132" Canvas.Top="50" Style="{StaticResource Caption}" Text="точка разрыва"/>
        </Canvas>

        <!-- По отметке: направление определится само, по разнице отметок -->
        <Canvas x:Name="DiagramLevel" Width="300" Height="62"
                Visibility="{Binding IsByLevel, Converter={StaticResource BoolVis}}">
          <TextBlock Canvas.Left="10" Canvas.Top="0" Style="{StaticResource Caption}" Text="уровень"/>
          <Path Data="M 10,20 L 290,20" Stroke="{StaticResource Muted}" StrokeThickness="1"
                StrokeDashArray="4 3"/>
          <Path Data="M 10,52 L 120,52" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 120,52 L 175,36" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 175,36 L 290,36" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 232,20 L 232,36" Stroke="{StaticResource Hot}" StrokeThickness="1.5"/>
          <TextBlock Canvas.Left="238" Canvas.Top="18" Style="{StaticResource Caption}" Text="отметка"/>
        </Canvas>

      </Grid>
    </Border>

    <!-- ===== Режим ===== -->
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="РЕЖИМ"/>
      <WrapPanel>
        <RadioButton x:Name="ChipDown" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Direction" Content="Опуск" MinWidth="88"
                     ToolTip="Часть трассы уходит ниже исходной отметки на заданную величину"/>
        <RadioButton x:Name="ChipUp" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Direction" Content="Подъем" MinWidth="88"
                     ToolTip="Часть трассы уходит выше исходной отметки на заданную величину"/>
        <RadioButton x:Name="ChipLevel" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Direction" Content="По отметке" MinWidth="108"
                     ToolTip="Часть трассы встаёт на заданную отметку от выбранного уровня. Опуск это или подъем, инструмент решит сам"/>
      </WrapPanel>
    </StackPanel>

    <!-- ===== Угол ===== -->
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="УГОЛ ОТ ГОРИЗОНТАЛИ"/>
      <WrapPanel>
        <RadioButton x:Name="Chip30" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="30°"/>
        <RadioButton x:Name="Chip45" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="45°"/>
        <RadioButton x:Name="Chip60" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="60°"/>
        <RadioButton x:Name="Chip90" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="90°"
                     ToolTip="Вертикальная вставка без горизонтального отступа"/>
        <RadioButton x:Name="ChipCustom" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="Своё"
                     ToolTip="Любой угол от 1 до 90 градусов"/>
        <TextBox x:Name="TxtCustomAngle" Style="{StaticResource TextBox.Field}"
                 Width="76" Height="30" Margin="2,0,0,0"
                 IsEnabled="{Binding IsCustomAngle}"
                 ToolTip="Угол в градусах, от 1 до 90"/>
      </WrapPanel>
    </StackPanel>

    <!-- ===== Величина (Опуск / Подъем) ===== -->
    <StackPanel Grid.Row="5" Margin="0,14,0,0"
                Visibility="{Binding IsByOffset, Converter={StaticResource BoolVis}}">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ВЕЛИЧИНА ПО ВЫСОТЕ"/>
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="TxtValue" Style="{StaticResource TextBox.Field}" Width="120"
                 Tag="напр. 500"
                 ToolTip="Смещение по вертикали в миллиметрах"/>
        <TextBlock Style="{StaticResource Caption}" Text="мм" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="TxtHint" Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Text="{Binding Hint}"/>
    </StackPanel>

    <!-- ===== Отметка от уровня ===== -->
    <StackPanel Grid.Row="6" Margin="0,14,0,0"
                Visibility="{Binding IsByLevel, Converter={StaticResource BoolVis}}">

      <TextBlock Style="{StaticResource FieldLabel}" Text="УРОВЕНЬ"/>
      <ComboBox x:Name="CmbLevel" Style="{StaticResource PP.ComboBox}" Margin="0,6,0,0"
                ToolTip="Уровень модели, от которого отсчитывается отметка"/>

      <TextBlock Style="{StaticResource FieldLabel}" Text="ОТМЕТКА ОТ УРОВНЯ, ММ" Margin="0,14,0,0"/>
      <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                 Text="Заполните одно поле — два других очистятся. Ниже уровня — со знаком минус."/>

      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,4,0">
          <TextBlock Style="{StaticResource Caption}" Text="низ"/>
          <TextBox x:Name="TxtElevBottom" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"
                   Tag="напр. 2750"
                   ToolTip="Отметка низа воздуховода или трубы (без изоляции)"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="4,0,4,0">
          <TextBlock Style="{StaticResource Caption}" Text="середина (ось)"/>
          <TextBox x:Name="TxtElevMiddle" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"
                   Tag="напр. 2850"
                   ToolTip="Отметка оси воздуховода или трубы"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="4,0,0,0">
          <TextBlock Style="{StaticResource Caption}" Text="верх"/>
          <TextBox x:Name="TxtElevTop" Style="{StaticResource TextBox.Field}" Margin="0,3,0,0"
                   Tag="напр. 2950"
                   ToolTip="Отметка верха воздуховода или трубы (без изоляции)"/>
        </StackPanel>
      </Grid>

      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Text="{Binding LevelHint}" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- ===== Галочки ===== -->
    <StackPanel Grid.Row="7" Margin="0,16,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="КАК РАБОТАТЬ"/>

      <CheckBox x:Name="ChkMulti" Style="{StaticResource PP.CheckBox}" Margin="0,6,0,0"
                Content="Несколько участков сразу"
                ToolTip="Точка разрыва и точка направления указываются один раз и переносятся на все выбранные участки по перпендикуляру. Подходит для параллельных трасс. Если участки уже выделены в модели, окно возьмёт их"/>

      <CheckBox x:Name="ChkMoveChain" Style="{StaticResource PP.CheckBox}" Margin="0,8,0,0"
                Content="Переносить всё, что дальше по трассе"
                ToolTip="Снято (обычный опуск): вместе с трассой едет горизонтальная часть до первого вертикального участка, сам стояк подрезается по высоте, а всё, что за ним — решётки, подводки — остаётся на своих отметках. Поставлено: вся ветка за точкой разрыва уезжает целиком"/>

      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="{Binding OptionsHint}"/>
    </StackPanel>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="9" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="10" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="{Binding RunLabel}" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"
                ToolTip="Дальше нужно указать участок и две точки на нём"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
