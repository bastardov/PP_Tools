<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Опуск / Подъем трассы"
        Width="470"
        MinWidth="430"
        MinHeight="430"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- описание -->
      <RowDefinition Height="Auto"/>   <!-- схема -->
      <RowDefinition Height="Auto"/>   <!-- направление -->
      <RowDefinition Height="Auto"/>   <!-- угол -->
      <RowDefinition Height="Auto"/>   <!-- величина -->
      <RowDefinition Height="*"/>      <!-- растяжка -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <!-- ===== Заголовок ===== -->
    <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="Опуск / Подъем трассы"/>

    <TextBlock Grid.Row="1" Style="{StaticResource Subtitle}" Margin="0,4,0,0"
               Text="Участок разрывается в указанной точке, часть трассы переносится по высоте и соединяется наклонной вставкой."/>

    <!-- ===== Схема: наглядный профиль результата ===== -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0,12,0,12">
      <Grid Height="62">

        <!-- Опуск -->
        <Canvas x:Name="DiagramDown" Width="300" Height="62"
                Visibility="{Binding IsDown, Converter={StaticResource BoolVis}}">
          <Path Data="M 10,16 L 120,16" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 120,16 L 175,46" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 175,46 L 290,46" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="115" Canvas.Top="11" Width="10" Height="10"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Hot}" StrokeThickness="1.8"/>
          <TextBlock Canvas.Left="132" Canvas.Top="0" Style="{StaticResource Caption}" Text="точка разрыва"/>
        </Canvas>

        <!-- Подъем -->
        <Canvas x:Name="DiagramUp" Width="300" Height="62"
                Visibility="{Binding IsUp, Converter={StaticResource BoolVis}}">
          <Path Data="M 10,46 L 120,46" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 120,46 L 175,16" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 175,16 L 290,16" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="115" Canvas.Top="41" Width="10" Height="10"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Hot}" StrokeThickness="1.8"/>
          <TextBlock Canvas.Left="132" Canvas.Top="50" Style="{StaticResource Caption}" Text="точка разрыва"/>
        </Canvas>

      </Grid>
    </Border>

    <!-- ===== Направление ===== -->
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="НАПРАВЛЕНИЕ"/>
      <WrapPanel>
        <RadioButton x:Name="ChipDown" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Direction" Content="Опуск" MinWidth="88"
                     ToolTip="Часть трассы уходит ниже исходной отметки"/>
        <RadioButton x:Name="ChipUp" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Direction" Content="Подъем" MinWidth="88"
                     ToolTip="Часть трассы уходит выше исходной отметки"/>
      </WrapPanel>
    </StackPanel>

    <!-- ===== Угол ===== -->
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="УГОЛ ОТ ГОРИЗОНТАЛИ"/>
      <WrapPanel>
        <RadioButton x:Name="Chip30" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="30°"/>
        <RadioButton x:Name="Chip45" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="45°"/>
        <RadioButton x:Name="Chip60" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="60°"/>
        <RadioButton x:Name="Chip90" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="90°"
                     ToolTip="Вертикальная вставка без горизонтального отступа"/>
        <RadioButton x:Name="ChipCustom" Style="{StaticResource RadioButton.Chip}" GroupName="Angle" Content="Своё"
                     ToolTip="Любой угол от 1 до 90 градусов"/>
        <TextBox x:Name="TxtCustomAngle" Style="{StaticResource TextBox.Field}"
                 Width="76" Height="30" Margin="2,0,0,0"
                 IsEnabled="{Binding IsCustomAngle}"
                 ToolTip="Угол в градусах, от 1 до 90"/>
      </WrapPanel>
    </StackPanel>

    <!-- ===== Величина ===== -->
    <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ВЕЛИЧИНА ПО ВЫСОТЕ"/>
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="TxtValue" Style="{StaticResource TextBox.Field}" Width="120"
                 ToolTip="Смещение по вертикали в миллиметрах"/>
        <TextBlock Style="{StaticResource Caption}" Text="мм" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="TxtHint" Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Text="{Binding Hint}"/>
    </StackPanel>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="7" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="8" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="{Binding RunLabel}" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"
                ToolTip="Дальше нужно указать участок и две точки на нём"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
