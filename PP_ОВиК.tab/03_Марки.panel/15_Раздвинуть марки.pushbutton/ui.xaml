<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Раздвинуть марки"
        Width="500"
        MinWidth="460"
        MinHeight="520"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- описание -->
      <RowDefinition Height="Auto"/>   <!-- схема -->
      <RowDefinition Height="Auto"/>   <!-- область -->
      <RowDefinition Height="Auto"/>   <!-- категории -->
      <RowDefinition Height="Auto"/>   <!-- направление -->
      <RowDefinition Height="Auto"/>   <!-- размеры -->
      <RowDefinition Height="Auto"/>   <!-- выноски -->
      <RowDefinition Height="Auto"/>   <!-- итог -->
      <RowDefinition Height="*"/>      <!-- растяжка -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <!-- ===== Заголовок ===== -->
    <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="Раздвинуть марки"/>

    <TextBlock Grid.Row="1" Style="{StaticResource Subtitle}" Margin="0,4,0,0"
               TextWrapping="Wrap"
               Text="{Binding Intro}"/>

    <!-- ===== Схема: было и стало ===== -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0,10,0,10">
      <Canvas Width="320" Height="58">
        <TextBlock Canvas.Left="34" Canvas.Top="0" Style="{StaticResource Caption}" Text="было"/>
        <Rectangle Canvas.Left="12" Canvas.Top="18" Width="86" Height="16" RadiusX="2" RadiusY="2"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Muted}" StrokeThickness="1.4"/>
        <Rectangle Canvas.Left="48" Canvas.Top="28" Width="86" Height="16" RadiusX="2" RadiusY="2"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Hot}" StrokeThickness="1.4"/>

        <Path Data="M 152,30 L 178,30" Stroke="{StaticResource Muted}" StrokeThickness="1.4"/>
        <Path Data="M 172,25 L 178,30 L 172,35" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

        <TextBlock Canvas.Left="234" Canvas.Top="0" Style="{StaticResource Caption}" Text="стало"/>
        <Rectangle Canvas.Left="212" Canvas.Top="16" Width="86" Height="16" RadiusX="2" RadiusY="2"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
        <Rectangle Canvas.Left="212" Canvas.Top="38" Width="86" Height="16" RadiusX="2" RadiusY="2"
                   Fill="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
        <Path Data="M 204,32 L 204,18 M 200,22 L 204,17 L 208,22" Stroke="{StaticResource Accent}" StrokeThickness="1.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <Path Data="M 204,38 L 204,52 M 200,48 L 204,53 L 208,48" Stroke="{StaticResource Accent}" StrokeThickness="1.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas>
    </Border>

    <!-- ===== Область ===== -->
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="КАКИЕ МАРКИ ДВИГАТЬ"/>
      <WrapPanel>
        <RadioButton x:Name="ChipAll" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Scope" Content="Все на виде"
                     ToolTip="Все марки активного вида. Закреплённые и лежащие в группах остаются на месте, но учитываются как препятствия"/>
        <RadioButton x:Name="ChipSelected" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Scope" Content="{Binding SelectedLabel}"
                     IsEnabled="{Binding HasSelection}"
                     ToolTip="Двигаются только выделенные марки, остальные стоят на местах и работают препятствиями. Для точечной правки узла на уже вылизанном плане"/>
        <RadioButton x:Name="ChipCategories" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Scope" Content="По категориям"
                     ToolTip="Двигаются марки только отмеченных категорий. Остальные учитываются как препятствия"/>
      </WrapPanel>
    </StackPanel>

    <!-- ===== Категории ===== -->
    <StackPanel Grid.Row="4" Margin="0,10,0,0"
                Visibility="{Binding IsScopeCategories, Converter={StaticResource BoolVis}}">
      <TextBlock Style="{StaticResource Caption}"
                 Text="Отмеченные категории раздвигаются, снятые остаются на месте."/>
      <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="10,8,6,8">
        <ScrollViewer MaxHeight="150"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="CategoriesHost"/>
        </ScrollViewer>
      </Border>
    </StackPanel>

    <!-- ===== Направление ===== -->
    <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="КУДА РАЗДВИГАТЬ"/>
      <WrapPanel>
        <RadioButton x:Name="ChipAuto" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Mode" Content="Автоматически"
                     ToolTip="Марка уходит в ту сторону, где сдвинуться нужно на меньшее расстояние. Меньше всего отрывает марку от элемента"/>
        <RadioButton x:Name="ChipVertical" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Mode" Content="Только по вертикали"
                     ToolTip="Марки расходятся строго вверх и вниз, привязка по горизонтали сохраняется. Для рядов решёток и арматуры вдоль одной оси"/>
        <RadioButton x:Name="ChipHorizontal" Style="{StaticResource RadioButton.Chip}"
                     GroupName="Mode" Content="Только по горизонтали"
                     ToolTip="Марки расходятся строго влево и вправо. Для стояков и вертикальных участков на плане"/>
      </WrapPanel>
    </StackPanel>

    <!-- ===== Размеры ===== -->
    <Grid Grid.Row="6" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,7,0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="ЗАЗОР МЕЖДУ МАРКАМИ, ММ"/>
        <TextBox x:Name="TxtGap" Style="{StaticResource TextBox.Field}" Margin="0,6,0,0"
                 Tag="напр. 1.5"
                 ToolTip="Просвет между соседними марками, в миллиметрах на листе"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   Text="{Binding GapHint}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="7,0,0,0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="МАКС. СМЕЩЕНИЕ МАРКИ, ММ"/>
        <TextBox x:Name="TxtOffset" Style="{StaticResource TextBox.Field}" Margin="0,6,0,0"
                 Tag="напр. 20"
                 ToolTip="Насколько далеко марке разрешено уехать от исходного места. Кому не хватит — останется на месте и попадёт в отчёт"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   Text="{Binding OffsetHint}"/>
      </StackPanel>
    </Grid>

    <!-- ===== Выноски ===== -->
    <StackPanel Grid.Row="7" Margin="0,16,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ВЫНОСКИ"/>

      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <CheckBox x:Name="ChkLeader" Style="{StaticResource PP.CheckBox}"
                  VerticalAlignment="Center"
                  ToolTip="Марка, уехавшая далеко, без выноски теряет связь со своим элементом"/>
        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"
                   Text="Включать выноску при смещении больше"/>
        <TextBox x:Name="TxtLeaderMm" Style="{StaticResource TextBox.Field}"
                 Width="64" VerticalAlignment="Center"
                 Tag="5"
                 IsEnabled="{Binding EnableLeader}"
                 ToolTip="Порог в миллиметрах на листе"/>
        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                   Text="мм"/>
      </StackPanel>

      <CheckBox x:Name="ChkElbow" Style="{StaticResource PP.CheckBox}" Margin="0,8,0,0"
                Content="Переносить изгиб выноски вместе с маркой"
                ToolTip="Снято: голова марки уезжает, а изгиб выноски остаётся висеть в старой точке — так работает Revit при перестановке марки из скрипта. Поставлено: изгиб едет за головой, как при перетаскивании мышью"/>
    </StackPanel>

    <!-- ===== Итог ===== -->
    <Border Grid.Row="8" Style="{StaticResource Card.Result}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="ЧТО ПОЛУЧИТСЯ"/>
        <TextBlock Style="{StaticResource Body.Result}" Margin="0,6,0,0"
                   TextWrapping="Wrap" Text="{Binding ResultText}"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   TextWrapping="Wrap" Text="{Binding ResultHint}"/>
      </StackPanel>
    </Border>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="10" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="11" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Раздвинуть" Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"
                ToolTip="Марки переставляются одной операцией — Ctrl+Z вернёт всё как было"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
