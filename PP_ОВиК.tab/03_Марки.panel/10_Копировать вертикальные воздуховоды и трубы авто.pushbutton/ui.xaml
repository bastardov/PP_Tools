<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Верт. авто — марки стояков"
        Width="520"
        MinWidth="440"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- заголовок -->
      <RowDefinition Height="Auto"/>   <!-- фильтр участков -->
      <RowDefinition Height="Auto"/>   <!-- подробности -->
      <RowDefinition Height="Auto"/>   <!-- разделитель -->
      <RowDefinition Height="Auto"/>   <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Верт. авто"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                 TextWrapping="Wrap"
                 Text="Эталонная марка копируется на вертикальные участки той же категории на активном виде."/>
    </StackPanel>

    <!-- ===== Фильтр участков ===== -->
    <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ФИЛЬТР УЧАСТКОВ"/>

      <Border Style="{StaticResource Card}" Margin="0,6,0,0">
        <StackPanel Margin="14,12,14,12">
          <CheckBox x:Name="ChkOnlyCrossing"
                    Style="{StaticResource PP.CheckBox}"
                    Content="Только участки, пересекающие уровень (стояки)"
                    ToolTip="Отметка уровня должна лежать строго между низом и верхом участка"/>
          <TextBlock Style="{StaticResource Caption}" Margin="26,6,0,0"
                     TextWrapping="Wrap"
                     Text="Такой участок виден сразу на двух планах — ему нужна марка для идентификации стояка."/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ===== Подробности ===== -->
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <ToggleButton x:Name="TglDetails"
                    Style="{StaticResource ToggleButton.Expander}"
                    Content="Подробнее"
                    HorizontalAlignment="Left"/>

      <TextBlock x:Name="TxtDetails"
                 Style="{StaticResource Caption}"
                 Margin="0,6,0,0"
                 TextWrapping="Wrap"
                 Visibility="{Binding IsChecked, ElementName=TglDetails, Converter={StaticResource BoolVis}}"
                 Text="Вертикальным считается участок с перепадом по высоте от 500 мм и смещением по осям X и Y не более 10 мм. Марка копируется с типом, выноской и смещением головы от эталона. Элементы, у которых на виде уже есть марка, пропускаются."/>
    </StackPanel>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="3" Style="{StaticResource Rule}" Margin="0,14,0,0"/>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus" Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена"
                Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Далее"
                Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
