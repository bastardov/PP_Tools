<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Объединить стены"
        Width="700"
        Height="760"
        MinWidth="580"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <!-- Неявные стили держим в области окна, чтобы не задеть интерфейс Revit -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>              <!-- заголовок -->
      <RowDefinition Height="*" MinHeight="220"/> <!-- разбор выделения -->
      <RowDefinition Height="Auto"/>              <!-- проёмы -->
      <RowDefinition Height="Auto"/>              <!-- тип стены -->
      <RowDefinition Height="Auto"/>              <!-- итог -->
      <RowDefinition Height="Auto"/>              <!-- разделитель -->
      <RowDefinition Height="Auto"/>              <!-- подвал -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Объединить стены"/>
      <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                 TextWrapping="Wrap"
                 Text="Куски одной стены — простенок, перемычка, сегменты в ряд — становятся одной стеной, чтобы в расчёте теплопотерь была одна позиция вместо нескольких."/>
    </StackPanel>

    <!-- ===== Разбор выделения ===== -->
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                 Text="РАЗБОР ВЫДЕЛЕННЫХ СТЕН"/>

      <TextBlock Grid.Row="1" Style="{StaticResource Caption}"
                 Margin="0,4,0,6" TextWrapping="Wrap"
                 Text="Список только для просмотра: объединятся все наборы из него. Под набором перечислены его куски с размерами. Строки цвета предупреждения объединить не получится — причина написана в строке."/>

      <Border Grid.Row="2" Style="{StaticResource Card}">
        <Grid>
          <ListBox x:Name="LstPlan"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="4"
                   ItemContainerStyle="{StaticResource PP.ListBoxItem}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

          <TextBlock x:Name="TxtEmpty"
                     Style="{StaticResource EmptyState}"
                     Visibility="Collapsed"
                     TextWrapping="Wrap"
                     Margin="24"
                     Text="Ничего не разобрано. Закройте окно и выберите стены, которые лежат в одной плоскости и касаются друг друга."/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Проёмы ===== -->
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="СТЕНЫ С ОКНАМИ И ДВЕРЯМИ"/>

      <Border Style="{StaticResource Card}" Margin="0,6,0,0">
        <StackPanel Margin="14,12,14,12">
          <CheckBox x:Name="ChkMoveInserts"
                    Style="{StaticResource PP.CheckBox}"
                    Content="Переносить проёмы на объединённую стену"/>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Без галочки стена с окном или дверью не объединяется. С галочкой окна и двери вставляются в новую стену заново — Revit не умеет менять им хост. Параметры проекта, марка, фаза и рабочий набор переносятся; марки-выноски на видах и размеры, привязанные к этим окнам, пропадут. Витражи галочки не требуют: они остаются на месте и врезаются в объединённую стену."/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ===== Тип объединённой стены ===== -->
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="ТИП ОБЪЕДИНЁННОЙ СТЕНЫ"/>
      <ComboBox x:Name="CmbType" Style="{StaticResource PP.ComboBox}"
                Margin="0,6,0,0"
                ToolTip="Каким типом будет создана объединённая стена"/>
      <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="В списке — типы стен из выделения. «Автоматически» берёт тип самого большого куска в каждом наборе: так объединяются куски с разными именами типов, но одинаковым пирогом."/>
    </StackPanel>

    <!-- ===== Итог ===== -->
    <Border Grid.Row="4" Style="{StaticResource Card.Result}" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="ЧТО ПРОИЗОЙДЁТ ПОСЛЕ НАЖАТИЯ"/>
        <TextBlock Style="{StaticResource Body.Result}"
                   TextWrapping="Wrap"
                   Foreground="{Binding ResultBrush}"
                   Text="{Binding ResultText}"/>
      </StackPanel>
    </Border>

    <!-- ===== Подвал ===== -->
    <Border Grid.Row="5" Style="{StaticResource Rule}" Margin="0,16,0,0"/>

    <Grid Grid.Row="6" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel" Content="Отмена"
                Style="{StaticResource Button.Flat}" Margin="0,0,8,0"/>
        <Button x:Name="BtnRun" Content="Объединить"
                Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
