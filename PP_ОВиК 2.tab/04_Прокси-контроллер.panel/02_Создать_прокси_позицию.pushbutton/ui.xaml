<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать прокси-позицию"
        Width="620"
        Height="660"
        MinWidth="560"
        MinHeight="590"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource Canvas}">

  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PP.ScrollBar}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource PP.ToolTip}"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Style="{StaticResource H1}"
               Text="Создать прокси-позицию"/>

    <TextBlock Grid.Row="1"
               Style="{StaticResource Subtitle}"
               Margin="0,4,0,0"
               Text="Заполните параметры немоделируемой позиции для добавления в спецификацию."/>

    <ScrollViewer Grid.Row="2"
                  Margin="0,14,0,0"
                  Padding="0,0,8,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="14">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="ОСНОВНЫЕ ПАРАМЕТРЫ"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="МАРКА" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtMark"
                         Style="{StaticResource TextBox.Field}"
                         ToolTip="Значение параметра ADSK_Марка"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="КОЛИЧЕСТВО" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtQuantity"
                         Style="{StaticResource TextBox.Field}"
                         ToolTip="Положительное число для параметра ADSK_Количество"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="НАИМЕНОВАНИЕ" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtName"
                         Style="{StaticResource TextBox.Field}"
                         ToolTip="Значение параметра ADSK_Наименование"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ЕДИНИЦА ИЗМЕРЕНИЯ" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUnit"
                         Style="{StaticResource TextBox.Field}"
                         ToolTip="Значение параметра ADSK_Единица измерения"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ПРОИЗВОДИТЕЛЬ" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtManufacturer"
                         Style="{StaticResource TextBox.Field}"
                         ToolTip="Значение параметра ADSK_Завод-изготовитель"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ПРИМЕЧАНИЕ" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtNote"
                         Style="{StaticResource TextBox.Field}"
                         ToolTip="Значение параметра ADSK_Примечание"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="КЛАССИФИКАЦИЯ ПОЗИЦИИ"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="КОД ПРАВИЛА" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbRule"
                          Style="{StaticResource PP.ComboBox}"
                          ToolTip="Код правила из настроек прокси-контроллера"/>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ТИП ПОЗИЦИИ" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbType"
                          Style="{StaticResource PP.ComboBox}"
                          ToolTip="Тип позиции из настроек прокси-контроллера"/>
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Caption}"
                       Margin="0,8,0,0"
                       Text="Состав списков настраивается в панели «Настройки»."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3"
            Style="{StaticResource Rule}"
            Margin="0,16,0,0"/>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TxtStatus"
                 Grid.Column="0"
                 Style="{StaticResource Status}"
                 Foreground="{Binding StatusBrush}"
                 Text="{Binding Status}"
                 Margin="0,0,12,0"
                 TextWrapping="Wrap"
                 TextTrimming="None"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCancel"
                Content="Отмена"
                Style="{StaticResource Button.Flat}"
                Margin="0,0,8,0"
                ToolTip="Закрыть окно без создания позиции"/>
        <Button x:Name="BtnRun"
                Content="Создать позицию"
                Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding IsValid}"
                ToolTip="Создать прокси-позицию с указанными параметрами"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
